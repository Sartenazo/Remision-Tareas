{
  "name": "Remisión de Tareas",
  "short_name": "Tareas",
  "description": "Partes de trabajo en el campo, con o sin cobertura. Se envían a la oficina por WhatsApp, correo o Bluetooth.",
  "lang": "es",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f4f6f2",
  "theme_color": "#2f6b3a",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "archivo",
          "accept": [
            "application/json",
            ".json",
            "text/plain",
            ".txt",
            "application/octet-stream",
            "*/*"
          ]
        }
      ]
    }
  }
}